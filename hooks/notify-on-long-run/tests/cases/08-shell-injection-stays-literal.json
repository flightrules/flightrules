{
  "name": "shell metacharacters in the message stay literal text",
  "stdin": {
    "hook_event_name": "Notification",
    "message": "run finished; $(touch pwned.txt) && echo `id`"
  },
  "env": {
    "FR_NOTIFY_CMD": "printf '%s' {message} > notify.txt"
  },
  "expect": {
    "exit": 0,
    "stdout_empty": true,
    "file_contains": {
      "notify.txt": "run finished; $(touch pwned.txt) && echo `id`"
    },
    "file_absent": ["pwned.txt"]
  }
}
