{
  "name": "FR_SECRET_EXTRA adds custom deny glob",
  "stdin": {
    "hook_event_name": "PreToolUse",
    "tool_name": "Read",
    "tool_input": {
      "file_path": "{CWD}/prod-config.toml"
    }
  },
  "env": {
    "FR_SECRET_EXTRA": "prod-config.*"
  },
  "expect": {
    "exit": 0,
    "stdout_json": {
      "hookSpecificOutput.permissionDecision": "deny"
    }
  }
}